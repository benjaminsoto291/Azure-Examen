{
	"name": "df_gold_dim_paciente",
	"properties": {
		"folder": {
			"name": "Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_silver_pacientes_sql",
						"type": "DatasetReference"
					},
					"name": "srcPac"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "gold_dim_paciente",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcPac",
				"srcPac derive(rango_etario = case(\r",
				"  isNull(date_of_birth), 'Desconocido',\r",
				"  year(currentDate()) - year(date_of_birth) < 18, '0-17',\r",
				"  year(currentDate()) - year(date_of_birth) < 36, '18-35',\r",
				"  year(currentDate()) - year(date_of_birth) < 51, '36-50',\r",
				"  year(currentDate()) - year(date_of_birth) < 66, '51-65',\r",
				"  '66+'\r",
				"),",
				"          proveedor_seguro = coalesce(insurance_provider, 'Self Pay')) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          patient_id_bk = patient_id,",
				"          nombre_completo = full_name,",
				"          genero = gender,",
				"          fecha_nacimiento = date_of_birth,",
				"          correo_electronico = email,",
				"          direccion = address,",
				"          rango_etario,",
				"          proveedor_seguro",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          paciente_key as integer,",
				"          patient_id_bk as integer,",
				"          nombre_completo as string,",
				"          genero as string,",
				"          fecha_nacimiento as date,",
				"          rango_etario as string,",
				"          correo_electronico as string,",
				"          direccion as string,",
				"          proveedor_seguro as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}